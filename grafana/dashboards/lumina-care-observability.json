{
  "title": "Lumina Care Observability",
  "timezone": "browser",
  "panels": [
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{result=\"hit\"}[5m])) / sum(rate(cache_gets_total[5m])) * 100",
          "legendFormat": "Hit Ratio %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          }
        }
      }
    },
    {
      "title": "Aspect Execution Latency (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(aspect_execution_time_seconds_bucket[5m])) by (le, class, method))",
          "legendFormat": "{{class}}.{{method}}"
        }
      ]
    },
    {
      "title": "Top Slow Methods",
      "type": "table",
      "targets": [
        {
          "expr": "topk(5, sum(rate(aspect_execution_time_seconds_sum[5m])) by (class, method) / sum(rate(aspect_execution_time_seconds_count[5m])) by (class, method))",
          "legendFormat": "{{class}}.{{method}}",
          "instant": true
        }
      ]
    },
    {
      "title": "Aspect Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aspect_failures_total[5m])) / sum(rate(aspect_execution_time_count[5m])) * 100",
          "legendFormat": "Failure Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ]
}
